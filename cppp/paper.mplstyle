# font
font.family:            sans-serif
font.sans-serif:        Arial
axes.titleweight:       bold

# font size
xtick.labelsize:        6
ytick.labelsize:        6
axes.labelsize:         8
axes.titlesize:         8
axes.labelpad:          2
figure.labelsize:       8

# axes and tick labels
xtick.bottom:           True 
ytick.left:             True 
xtick.major.size:       4     
xtick.major.width:      1
xtick.major.pad:        4
ytick.major.size:       4     
ytick.major.width:      1     
ytick.major.pad:        4
axes.spines.top:        False
axes.spines.right:      False
axes.linewidth:         1

# legend
legend.fontsize:        12
legend.title_fontsize:  14
legend.frameon:         False

# latex
text.usetex:            False
#text.latex.preamble:    "\usepackage{uarial} \usepackage{cmbright}" 

# plot elements
lines.linewidth:        2 
lines.markersize :      3
